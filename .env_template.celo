# Celo Crawler Configuration
CRAWLER_LOG_LEVEL=info
CRAWLER_PORT=30304
CRAWLER_METRICS_PORT=9083
CRAWLER_PEERS_BACKUP=30m
CRAWLER_PERSIST_CONNEVENTS=false

# Note: Celo L2 uses port 30303 (standard Ethereum/Geth P2P port) for op-geth
# Using 30304 externally to avoid conflicts with other networks
# Bootnodes are configured in pkg/config/bootnodes.go


